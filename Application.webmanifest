  "id": "/",
  "lang": "en",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "name": "Bitscoper Computer Museum",
  "orientation": "any",
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+BitscoperComputerMuseum",
      "url": "/#%s"
    }
  ],
  "scope": "/",
  "scope_extensions": [
    {
      "origin": "https://bitscoper-computer-museum.site/",
      "type": "origin"
    }
  ],
